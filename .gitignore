# =============================================================================
# SECURITY RULES AND IGNORED FILES - ANSIBLE ACM DR
# =============================================================================

# Local-only credentials and scratch files (never committed)
.local/

# Local environment scripts and credentials (REQUIRED)
env-setup.sh
*env*.sh
*.env
.env*

# Ansible Vault files and secrets
*vault*
secrets.yml
vars/secrets.yml

# Private keys, certificates and access tokens
*.pem
*.key
*.crt
*.id_rsa

# Python artifacts and locally downloaded Ansible collections
__pycache__/
*.pyc
.collections/
.python_history

# Execution cache and temporary state
.ansible/
roles/*/.ansible/
.retry
*.retry
*.log
.kube/

# Collection build artifacts (ansible-galaxy collection build output)
*.tar.gz

# antsibull-changelog plugin cache
changelogs/.plugin-cache.yaml

# Execution Environment build artifacts (generated by ansible-builder)
context/

# ROSA provisioning session artifacts (committed by mistake; excluded by galaxy.yml too)
sts_*.json

# Lab compliance report renders (generated by scripts/testing/render_compliance_reports.yml)
scripts/testing/rendered_reports/

# Environment-specific import vars (contains AAP password - never commit)

# Claude Code IDE configuration (local dev only; not collection content)
.claude/
CLAUDE.md
.agents/

# Cursor IDE configuration (local dev only; contains lab MCP server URL)
.cursor/

# Claude Code project MCP config (contains lab token; gitignored)
.mcp.json

# Scratch and temp directories
tmp/

# Filled-in copy of examples/aap/import-vars.yml.example: holds the AAP URL and OAuth token
examples/aap/import-vars.yml
