apiVersion: v1
kind: Secret
metadata:
  name: repo-{{ acm_argocd_instance_setup_name }}-creds
  namespace: {{ acm_argocd_instance_setup_namespace }}
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  url: {{ acm_argocd_instance_setup_repo_url }}
  username: {{ acm_argocd_instance_setup_repo_username | default('') }}
  password: {{ acm_argocd_instance_setup_repo_pat | default('') }}
