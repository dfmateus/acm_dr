---
apiVersion: v1
kind: Secret
metadata:
  name: "{{ acm_dr_hub_setup_oadp_cloud_secret_name | default('cloud-credentials') }}"
  namespace: "{{ acm_dr_hub_setup_oadp_namespace | default('open-cluster-management-backup') }}"
type: Opaque
stringData:
  cloud: |
    [default]
    aws_access_key_id={{ acm_dr_hub_setup_aws_access_key_id }}
    aws_secret_access_key={{ acm_dr_hub_setup_aws_secret_access_key }}
