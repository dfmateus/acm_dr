---
apiVersion: v1
kind: Secret
metadata:
  name: "{{ acm_dr_hub_setup_oadp_cloud_secret_name | default('cloud-credentials') }}"
  namespace: "{{ acm_dr_hub_setup_oadp_namespace | default('open-cluster-management-backup') }}"
type: Opaque
stringData:
  cloud: |
    AZURE_SUBSCRIPTION_ID={{ acm_dr_hub_setup_azure_subscription_id }}
    AZURE_TENANT_ID={{ acm_dr_hub_setup_azure_tenant_id }}
    AZURE_CLIENT_ID={{ acm_dr_hub_setup_azure_client_id }}
    AZURE_CLIENT_SECRET={{ acm_dr_hub_setup_azure_client_secret }}
    AZURE_RESOURCE_GROUP={{ acm_dr_hub_setup_azure_resource_group }}
    AZURE_CLOUD_NAME=AzurePublicCloud