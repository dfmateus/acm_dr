---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ acm_dr_hub_setup_automation_namespace }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ acm_dr_hub_setup_automation_sa_name }}
  namespace: {{ acm_dr_hub_setup_automation_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ acm_dr_hub_setup_automation_sa_name }}-admin
subjects:
  - kind: ServiceAccount
    name: {{ acm_dr_hub_setup_automation_sa_name }}
    namespace: {{ acm_dr_hub_setup_automation_namespace }}
roleRef:
  kind: ClusterRole
  name: cluster-admin
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ acm_dr_hub_setup_automation_secret_name }}
  namespace: {{ acm_dr_hub_setup_automation_namespace }}
  annotations:
    kubernetes.io/service-account.name: {{ acm_dr_hub_setup_automation_sa_name }}
type: kubernetes.io/service-account-token
