apiVersion: operator.open-cluster-management.io/v1
kind: MultiClusterHub
metadata:
  name: {{ acm_dr_hub_setup_mch_name }}
  namespace: {{ acm_dr_hub_setup_mch_namespace }}
spec:
  localClusterName: local-cluster
  imagePullSecret: {{ acm_dr_hub_setup_mch_pull_secret }}
  overrides:
    components:
      - name: cluster-backup
        enabled: true
        configOverrides: {}