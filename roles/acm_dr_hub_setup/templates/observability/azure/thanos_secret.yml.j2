apiVersion: v1
kind: Secret
metadata:
  name: thanos-object-storage
  namespace: {{ acm_dr_hub_setup_observability_namespace | default('open-cluster-management-observability') }}
type: Opaque
stringData:
  thanos.yaml: |
    type: AZURE
    config:
      storage_account: {{ acm_dr_hub_setup_computed_storage_account | default(acm_dr_hub_setup_azure_storage_account_name) | trim }}
      storage_account_key: {{ acm_dr_hub_setup_azure_storage_account_key | trim }}
      container: {{ acm_dr_hub_setup_azure_container_observability | default('acm-observability') | trim }}
      endpoint: blob.core.windows.net
      max_retries: 3