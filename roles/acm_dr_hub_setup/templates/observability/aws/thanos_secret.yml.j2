apiVersion: v1
kind: Secret
metadata:
  name: thanos-object-storage
  namespace: {{ acm_dr_hub_setup_observability_namespace | default('open-cluster-management-observability') }}
type: Opaque
stringData:
  thanos.yaml: |
    type: S3
    config:
      bucket: {{ acm_dr_hub_setup_aws_s3_bucket_observability | trim }}
      endpoint: s3.{{ acm_dr_hub_setup_aws_region | trim }}.amazonaws.com
      insecure: false
      access_key: {{ acm_dr_hub_setup_aws_access_key_id | trim }}
      secret_key: {{ acm_dr_hub_setup_aws_secret_access_key | trim }}
