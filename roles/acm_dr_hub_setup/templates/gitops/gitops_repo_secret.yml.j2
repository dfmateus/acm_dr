apiVersion: v1
kind: Secret
metadata:
  name: repo-acm-ocp-creds
  namespace: {{ acm_dr_hub_setup_gitops_repo_secret_namespace | default(acm_dr_hub_setup_gitops_namespace_acm) | default('openshift-gitops-acm') }}
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  url: {{ acm_dr_hub_setup_github_repo_url | mandatory }}
  username: {{ acm_dr_hub_setup_github_username | mandatory }}
  password: {{ acm_dr_hub_setup_github_pat }}