---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ acm_dr_cluster_onboard_namespace }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ acm_dr_cluster_onboard_sa_name }}
  namespace: {{ acm_dr_cluster_onboard_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ acm_dr_cluster_onboard_crb_name }}
subjects:
  - kind: ServiceAccount
    name: {{ acm_dr_cluster_onboard_sa_name }}
    namespace: {{ acm_dr_cluster_onboard_namespace }}
roleRef:
  kind: ClusterRole
  name: {{ acm_dr_cluster_onboard_cluster_role }}
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ acm_dr_cluster_onboard_token_secret }}
  namespace: {{ acm_dr_cluster_onboard_namespace }}
  annotations:
    kubernetes.io/service-account.name: {{ acm_dr_cluster_onboard_sa_name }}
type: kubernetes.io/service-account-token
