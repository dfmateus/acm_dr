{# roles/acm_dr_kubeconfig_resolver/templates/runtime_kubeconfig.yml.j2         #}
{# Generates a multi-context kubeconfig from three sources:                      #}
{#   1. Per-cluster env var entries (ACM_DR_SOURCE_*, ACM_DR_DEST_*, etc.)       #}
{#   2. Spoke fleet kubeconfig file (ACM_DR_SPOKE_FLEET_KUBECONFIG)              #}
{#   3. Passive hub fleet kubeconfig file (ACM_DR_PASSIVE_HUB_FLEET_KUBECONFIG)  #}
{# Written to disk with mode 0600 by the resolver task - contains tokens.        #}
apiVersion: v1
kind: Config
preferences: {}
{# ---------------------------------------------------------------------- #}
{# CLUSTERS - per-cluster entries, spoke fleet, and passive hub fleet     #}
{# ---------------------------------------------------------------------- #}
clusters:
{% for entry in acm_dr_kubeconfig_resolver_entries %}
  - name: {{ entry.context_name }}
    cluster:
      server: {{ entry.host }}
{% if entry.ca_data | default('') | length > 0 %}
      certificate-authority-data: {{ entry.ca_data }}
{% elif acm_dr_kubeconfig_resolver_skip_tls_when_no_ca | default(true) | bool %}
      insecure-skip-tls-verify: true
{% endif %}
{% endfor %}
{% if acm_dr_kubeconfig_resolver_fleet_parsed is defined %}
{# spoke fleet clusters #}
{% for cluster in acm_dr_kubeconfig_resolver_fleet_parsed.clusters | default([]) %}
  - name: {{ cluster.name }}
    cluster:
{{ cluster.cluster | to_nice_yaml(indent=2) | indent(6, true) }}
{% endfor %}
{% endif %}
{% if acm_dr_kubeconfig_resolver_passive_hub_fleet_parsed is defined %}
{# passive hub fleet clusters (N+ topology) #}
{% for cluster in acm_dr_kubeconfig_resolver_passive_hub_fleet_parsed.clusters | default([]) %}
  - name: {{ cluster.name }}
    cluster:
{{ cluster.cluster | to_nice_yaml(indent=2) | indent(6, true) }}
{% endfor %}
{% endif %}

{# ---------------------------------------------------------------------- #}
{# USERS - per-cluster entries, spoke fleet, and passive hub fleet         #}
{# ---------------------------------------------------------------------- #}
users:
{% for entry in acm_dr_kubeconfig_resolver_entries %}
  - name: {{ entry.context_name }}
    user:
      token: {{ entry.token }}
{% endfor %}
{% if acm_dr_kubeconfig_resolver_fleet_parsed is defined %}
{# spoke fleet users #}
{% for user in acm_dr_kubeconfig_resolver_fleet_parsed.users | default([]) %}
  - name: {{ user.name }}
    user:
{{ user.user | to_nice_yaml(indent=2) | indent(6, true) }}
{% endfor %}
{% endif %}
{% if acm_dr_kubeconfig_resolver_passive_hub_fleet_parsed is defined %}
{# passive hub fleet users (N+ topology) #}
{% for user in acm_dr_kubeconfig_resolver_passive_hub_fleet_parsed.users | default([]) %}
  - name: {{ user.name }}
    user:
{{ user.user | to_nice_yaml(indent=2) | indent(6, true) }}
{% endfor %}
{% endif %}

{# ---------------------------------------------------------------------- #}
{# CONTEXTS - per-cluster entries, spoke fleet, and passive hub fleet      #}
{# ---------------------------------------------------------------------- #}
contexts:
{% for entry in acm_dr_kubeconfig_resolver_entries %}
  - name: {{ entry.context_name }}
    context:
      cluster: {{ entry.context_name }}
      user: {{ entry.context_name }}
{% endfor %}
{% if acm_dr_kubeconfig_resolver_fleet_parsed is defined %}
{# spoke fleet contexts #}
{% for ctx in acm_dr_kubeconfig_resolver_fleet_parsed.contexts | default([]) %}
  - name: {{ ctx.name }}
    context:
{{ ctx.context | to_nice_yaml(indent=2) | indent(6, true) }}
{% endfor %}
{% endif %}
{% if acm_dr_kubeconfig_resolver_passive_hub_fleet_parsed is defined %}
{# passive hub fleet contexts - these must match values in additional_passive_hubs survey field #}
{% for ctx in acm_dr_kubeconfig_resolver_passive_hub_fleet_parsed.contexts | default([]) %}
  - name: {{ ctx.name }}
    context:
{{ ctx.context | to_nice_yaml(indent=2) | indent(6, true) }}
{% endfor %}
{% endif %}

{# ---------------------------------------------------------------------- #}
{# CURRENT-CONTEXT - first per-cluster entry, else first fleet context    #}
{# ---------------------------------------------------------------------- #}
{% if acm_dr_kubeconfig_resolver_entries | length > 0 %}
current-context: {{ acm_dr_kubeconfig_resolver_entries[0].context_name }}
{% elif acm_dr_kubeconfig_resolver_fleet_parsed is defined and acm_dr_kubeconfig_resolver_fleet_parsed.contexts | default([]) | length > 0 %}
current-context: {{ acm_dr_kubeconfig_resolver_fleet_parsed.contexts[0].name }}
{% elif acm_dr_kubeconfig_resolver_passive_hub_fleet_parsed is defined and acm_dr_kubeconfig_resolver_passive_hub_fleet_parsed.contexts | default([]) | length > 0 %}
current-context: {{ acm_dr_kubeconfig_resolver_passive_hub_fleet_parsed.contexts[0].name }}
{% endif %}
