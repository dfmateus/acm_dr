[defaults]
# Defines the directory where Ansible should look for Roles.
# Works identically on CLI (ansible-core) and inside AAP Execution Environments.
roles_path = ./roles

# Disables deprecation warnings for legacy modules or features.
# Keeps execution logs in CI/CD pipelines much cleaner, focusing only on useful output.
deprecation_warnings = False

# Allows Ansible to automatically discover the Python interpreter path on the target host.
# Prevents failures in heterogeneous environments with different Linux distributions (e.g., RHEL 8 with Python 3.6 vs. RHEL 9 with Python 3.9).
interpreter_python = auto

# Forces Ansible to use the default output callback plugins even for Ad-Hoc commands (ansible command).
bin_ansible_callbacks = True

# Ignores invalid characters generated by dynamic inventory sources.
# Prevents execution from breaking due to syntax errors in group names imported from Cloud providers or CMDBs.
force_valid_group_names = ignore

# Disables interactive SSH key checking (known_hosts file validation).
# Essential in Enterprise automation to prevent the process from hanging at the terminal awaiting manual confirmation (yes/no).
host_key_checking = False

# Ignores warnings when Ansible performs implicit type conversions (e.g., integer to string).
# Reduces noise in playbooks that handle dynamic Kubernetes variables.
string_conversion_action = ignore

# Defines the maximum timeout (in seconds) when attempting to establish an initial SSH connection to the remote host.
timeout = 60

# Defines which callback plugin will format the console output.
# The ansible-core 'default' is highly optimized for readability.
stdout_callback = default

# Hides hosts or tasks that were skipped due to 'when' conditions evaluating to false.
# Drastically reduces visual noise in logs, highlighting only what actually changed or failed.
display_skipped_hosts = False

# Formats task results as indented JSON instead of single-line inline JSON.
# JSON renders all Unicode (emojis included) correctly, unlike YAML which
# escapes characters above U+FFFF via PyYAML (\U0001FXXX).
# In ansible-core 2.21+ the key is callback_result_format under [defaults],
# not result_format under [callback_default] (old syntax, silently ignored).
callback_result_format = json

# Pretty-prints JSON results with indentation on the terminal or AAP console.
callback_format_pretty = True


[ssh_connection]
# Disables pseudo-TTY allocation for SSH connections.
# Prevents timeout failures and hangs during operations involving node restarts or heavy headless commands.
usetty = False

# Drastically accelerates Ansible execution by running modules in memory, without the need to physically transfer Python files via SFTP/SCP.
# Note: Requires 'requiretty' to be disabled in /etc/sudoers on the target host (default on modern systems).
pipelining = True

# Falls back to SCP if SFTP transfer fails or is blocked by restrictive firewall/SSHD policies on the target.
scp_if_ssh = True

# Number of automatic reconnection attempts in case of a transient failure at the SSH network layer (brief socket drops, not module-level errors).
retries = 3

# Raw optimization arguments passed to the OpenSSH binary:
# -C: Enables data compression over the network, saving bandwidth.
# ControlMaster/ControlPersist: Enables multiplexing. Reuses the same TCP/SSH session for 60s, avoiding the overhead of new cryptographic handshakes for each task.
# UserKnownHostsFile/StrictHostKeyChecking: Enforces the host_key_checking bypass directly at the SSH protocol level.
# ConnectTimeout: Aggressive timeout (5s) to quickly give up on unreachable ports at the TCP packet level.
ssh_args = -C -o ControlMaster=auto -o ControlPersist=60s -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o ConnectTimeout=5